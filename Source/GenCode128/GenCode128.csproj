<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Authors>Chris Wuestefeld, Petr Kadlec, Jan Záruba</Authors>
        <Company />
        <Copyright>2006 Chris Wuestefeld, 2017 Petr Kadlec</Copyright>
        <Description>Code128 barcode generator</Description>
        <PackageReleaseNotes>
            Updated to use ImageSharp version 2.1.12
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mormegil-cz/GenCode128</RepositoryUrl>
        <PackageId>GenCode128Core</PackageId>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Product>GenCode128Core</Product>
        <PackageTags>Barcode, GenCode128, GenCode128Core, Code128, generate barcode</PackageTags>
        <PackageProjectUrl>https://github.com/mormegil-cz/GenCode128</PackageProjectUrl>
        <LangVersion>default</LangVersion>
        <PackageVersion>2.0.0</PackageVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\Images\GenCode128.png" Pack="true" PackagePath="\Images"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0" />
    </ItemGroup>
</Project>